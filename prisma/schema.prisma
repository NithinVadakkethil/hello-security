generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  MANAGER
  SUPERVISOR
  SECURITY
  CLEANER
  SERVICE_ENGINEER
  TECHNICIAN
  LIFE_GUARD
  PLUMBER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum IdentificationMethod {
  QR
  RFID
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  DOWNLOAD
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  NOT_VERIFIED
}

model Client {
  id String @id @default(cuid())

  clientCode String @unique

  companyName String

  email String @unique

  authorizedPerson String?

  phone String?

  address String?

  subscriptionStatus SubscriptionStatus @default(TRIAL)

  identificationMethod IdentificationMethod @default(QR)

  maxEmployees Int @default(50)

  maxCheckpoints Int @default(50)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  employees Employee[]

  assignments GuardAssignment[]

  patrolSessions PatrolSession[]

  sites Site[]

  shifts Shift[]

  patrolRoutes PatrolRoute[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  incidents Incident[]

  snags Snag[]

  snagCategories SnagCategory[]
}

model User {
  id String @id @default(cuid())

  clientId String?

  employeeId String? @unique

  client   Client?   @relation(fields: [clientId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  email    String   @unique
  password String
  rawPassword String?
  role     UserRole

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  verifiedPatrols PatrolSession[] @relation("VerifiedPatrols")

  snagComments       SnagComment[]
  snagHistoryEntries SnagHistory[]
  snagAssignmentsTo  SnagAssignment[] @relation("SnagAssignedTo")
  snagAssignmentsBy  SnagAssignment[] @relation("SnagAssignedBy")
}

model Employee {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  employeeNumber String

  firstName String

  lastName String?

  email String?

  phone String?

  photo String?

  designation String?

  joiningDate DateTime?

  identificationMethod IdentificationMethod @default(QR)

  qrCode String?

  rfidTag String?

  status EmployeeStatus @default(ACTIVE)

  role UserRole @default(SECURITY)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User?

  incidents Incident[]

  snags Snag[]

  @@unique([clientId, employeeNumber])
}

model Site {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  siteCode String

  name String

  gates Gate[]

  patrolRoutes PatrolRoute[]

  assignments GuardAssignment[]

  snags Snag[]

  address String?

  latitude Float?

  longitude Float?

  radius Int @default(100)

  contactPerson String?

  contactPhone String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@unique([clientId, siteCode])
}

model Gate {
  id String @id @default(cuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  patrolCheckpoints PatrolCheckpoint[]

  routeGates PatrolRouteGate[]

  assignmentGates GuardAssignmentGate[]

  incidents Incident[]

  snags Snag[]

  subTasks GateSubTask[]

  gateCode String

  name String

  description String?

  latitude Float?

  longitude Float?

  sequence Int

  qrCode String?

  nfcTag String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@unique([siteId, gateCode])
}

model Shift {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  shiftCode String

  name String

  startTime String

  endTime String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@unique([clientId, shiftCode])
}

model GuardAssignment {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  assignmentType String @default("ROUTE")

  patrolRouteId String?
  patrolRoute   PatrolRoute? @relation(fields: [patrolRouteId], references: [id])

  assignmentGates GuardAssignmentGate[]

  patrolSessions PatrolSession[]

  effectiveFrom DateTime

  effectiveTo DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([siteId])
  @@index([shiftId])
  @@index([patrolRouteId])
}

model GuardAssignmentGate {
  id String @id @default(cuid())

  assignmentId String
  assignment   GuardAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  sequence Int @default(1)

  createdAt DateTime @default(now())

  @@unique([assignmentId, gateId])
  @@index([assignmentId])
  @@index([gateId])
}

model PatrolRoute {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  routeCode String

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  assignments GuardAssignment[]

  routeGates PatrolRouteGate[]

  @@unique([siteId, name])
  @@unique([clientId, routeCode])
}

model PatrolRouteGate {
  id String @id @default(cuid())

  patrolRouteId String
  patrolRoute PatrolRoute @relation(fields: [patrolRouteId], references: [id])

  gateId String
  gate Gate @relation(fields: [gateId], references: [id])

  sequence Int

  expectedDuration Int? // minutes to next checkpoint

  createdAt DateTime @default(now())

  @@unique([patrolRouteId, gateId])
  @@unique([patrolRouteId, sequence])
}

model PatrolCheckpoint {
  id String @id @default(cuid())

  patrolSessionId String
  patrolSession   PatrolSession @relation(fields: [patrolSessionId], references: [id])

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  latitude  Float?
  longitude Float?

  remarks String?
  status  String?
  images  String[] @default([])

  subTaskResponses PatrolSubTaskResponse[]

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([patrolSessionId])
  @@index([gateId])
}

model PatrolSession {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignmentId String
  assignment   GuardAssignment @relation(fields: [assignmentId], references: [id])

  checkpoints PatrolCheckpoint[]

  incidents Incident[]

  snags Snag[]

  patrolCode String

  status PatrolStatus @default(IN_PROGRESS)

  startedAt DateTime

  endedAt DateTime?

  pauseCount Int @default(0)

  totalDuration Int?

  remarks String?

  verificationStatus VerificationStatus @default(PENDING)

  verifiedById String?
  verifiedBy   User?   @relation("VerifiedPatrols", fields: [verifiedById], references: [id])

  verificationTime DateTime?

  supervisorRemarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, patrolCode])
}

model RefreshToken {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  tokenHash String

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  action AuditAction

  entity String

  entityId String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model Counter {
  id String @id @default(cuid())

  entity String
  
  clientId String @default("GLOBAL")

  value Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([entity, clientId])
}

model Incident {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  type           String
  severity       String
  description    String
  images         String[] @default([])
  patrolSessionId String?
  patrolSession   PatrolSession? @relation(fields: [patrolSessionId], references: [id])
  gateId         String?
  gate           Gate?          @relation(fields: [gateId], references: [id])
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([employeeId])
}

model GateSubTask {
  id           String                  @id @default(cuid())
  gateId       String
  gate         Gate                    @relation(fields: [gateId], references: [id], onDelete: Cascade)
  role         UserRole                @default(SECURITY)
  taskName     String
  description  String?
  displayOrder Int                     @default(0)
  isRequired   Boolean                 @default(true)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  responses    PatrolSubTaskResponse[]

  @@unique([gateId, role, taskName])
  @@index([gateId])
  @@index([role])
}

model PatrolSubTaskResponse {
  id                 String           @id @default(cuid())
  patrolCheckpointId String
  patrolCheckpoint   PatrolCheckpoint @relation(fields: [patrolCheckpointId], references: [id], onDelete: Cascade)
  gateSubTaskId      String
  gateSubTask        GateSubTask      @relation(fields: [gateSubTaskId], references: [id], onDelete: Cascade)
  answer             String           // "YES" | "NO"
  remarks            String?
  images             String[]         @default([])
  answeredAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([patrolCheckpointId, gateSubTaskId])
  @@index([patrolCheckpointId])
  @@index([gateSubTaskId])
}

model SnagCategory {
  id           String            @id @default(cuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id])
  name         String
  description  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subCategories SnagSubCategory[]
  snags        Snag[]

  @@unique([clientId, name])
  @@index([clientId])
}

model SnagSubCategory {
  id         String       @id @default(cuid())
  categoryId String
  category   SnagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  description String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  snags      Snag[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Snag {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  siteId          String
  site            Site             @relation(fields: [siteId], references: [id])
  gateId          String?
  gate            Gate?            @relation(fields: [gateId], references: [id])
  patrolSessionId String?
  patrolSession   PatrolSession?   @relation(fields: [patrolSessionId], references: [id])
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  categoryId      String?
  categoryRel     SnagCategory?    @relation(fields: [categoryId], references: [id])
  subCategoryId   String?
  subCategoryRel  SnagSubCategory? @relation(fields: [subCategoryId], references: [id])
  category        String           // Category Name text (for predefined master UI compatibility)
  subCategory     String?          // Sub-category Name text
  description     String
  priority        String           // "LOW" | "MEDIUM" | "HIGH"
  status          String           @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  images          String[]         @default([])
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  comments        SnagComment[]
  history         SnagHistory[]
  assignments     SnagAssignment[]

  @@index([clientId])
  @@index([siteId])
  @@index([employeeId])
  @@index([patrolSessionId])
}

model SnagComment {
  id        String   @id @default(cuid())
  snagId    String
  snag      Snag     @relation(fields: [snagId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   String
  createdAt DateTime @default(now())

  @@index([snagId])
  @@index([userId])
}

model SnagHistory {
  id            String   @id @default(cuid())
  snagId        String
  snag          Snag     @relation(fields: [snagId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  previousState String?
  newState      String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([snagId])
  @@index([userId])
}

model SnagAssignment {
  id           String    @id @default(cuid())
  snagId       String
  snag         Snag      @relation(fields: [snagId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User      @relation("SnagAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User      @relation("SnagAssignedBy", fields: [assignedById], references: [id])
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@index([snagId])
  @@index([assignedToId])
  @@index([assignedById])
}

