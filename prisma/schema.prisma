generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  MANAGER
  SUPERVISOR
  SECURITY
  CLEANER
  SERVICE_ENGINEER
  TECHNICIAN
  LIFE_GUARD
  PLUMBER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum IdentificationMethod {
  QR
  RFID
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  DOWNLOAD
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  NOT_VERIFIED
}

enum FaceEnrollmentStatus {
  NOT_REGISTERED
  REGISTERED
  RE_ENROLL_REQUIRED
  REVOKED
}

model Client {
  id String @id @default(cuid())

  clientCode String @unique

  companyName String

  email String @unique

  authorizedPerson String?

  phone String?

  address String?

  subscriptionStatus SubscriptionStatus @default(TRIAL)

  identificationMethod IdentificationMethod @default(QR)

  maxEmployees Int @default(50)

  maxCheckpoints Int @default(50)

  isActive Boolean @default(true)

  clientLogoUrl String?

  dashboardImageUrl String?

  dashboardImageAspectRatio Float?

  dashboardImageOrientation String? @default("LANDSCAPE")

  dashboardImageFocalPosition String? @default("center")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  employees Employee[]

  assignments GuardAssignment[]

  patrolSessions PatrolSession[]

  sites Site[]

  shifts Shift[]

  patrolRoutes PatrolRoute[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  incidents Incident[]

  snags Snag[]

  snagCategories SnagCategory[]

  notificationSettings ClientNotificationSettings?

  notificationDeliveries NotificationDelivery[]

  subtaskMasters SubTaskMaster[]

  managerMemberships ManagerClientMembership[] @relation("ClientManagerMemberships")

  faceEnrollments FaceEnrollment[]

  mandatoryPatrolInstances MandatoryPatrolInstance[]

  notifications Notification[]

  attendances Attendance[]
}

model User {
  id String @id @default(cuid())

  clientId String?

  employeeId String? @unique

  client   Client?   @relation(fields: [clientId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  email    String   @unique
  password String
  rawPassword String?
  role     UserRole
  supervisedRole UserRole?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  verifiedPatrols PatrolSession[] @relation("VerifiedPatrols")

  snagComments       SnagComment[]
  snagHistoryEntries SnagHistory[]
  snagAssignmentsTo  SnagAssignment[] @relation("SnagAssignedTo")
  snagAssignmentsBy  SnagAssignment[] @relation("SnagAssignedBy")

  managerMemberships    ManagerClientMembership[] @relation("UserManagerMemberships")
  managerPatrolSessions PatrolSession[]           @relation("ManagerPatrolSessions")
  notificationRecipients NotificationUserRecipient[]
}

model Employee {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  employeeNumber String

  firstName String

  lastName String?

  email String?

  phone String?

  photo String?

  designation String?

  companyName String?

  joiningDate DateTime?

  siraCardExpiryDate DateTime?

  siraCardFrontImage String?

  siraCardBackImage String?

  identificationMethod IdentificationMethod @default(QR)

  qrCode String?

  rfidTag String?

  status EmployeeStatus @default(ACTIVE)

  role UserRole @default(SECURITY)

  supervisedRole UserRole?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User?

  incidents Incident[]

  snags Snag[]

  faceEnrollment FaceEnrollment?

  mandatoryPatrolInstances MandatoryPatrolInstance[]

  attendances Attendance[]

  @@unique([clientId, employeeNumber])
  @@index([clientId, supervisedRole])
}

model Site {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  siteCode String

  name String

  gates Gate[]

  patrolRoutes PatrolRoute[]

  assignments GuardAssignment[]

  snags Snag[]

  attendances Attendance[]

  address String?

  latitude Float?

  longitude Float?

  radius Int @default(100)

  contactPerson String?

  contactPhone String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@unique([clientId, siteCode])
}

model Gate {
  id String @id @default(cuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  patrolCheckpoints PatrolCheckpoint[]

  routeGates PatrolRouteGate[]

  assignmentGates GuardAssignmentGate[]

  incidents Incident[]

  snags Snag[]

  subTasks GateSubTask[]

  gateCode String

  name String

  description String?

  latitude Float?

  longitude Float?

  sequence Int

  qrCode String?

  nfcTag String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@unique([siteId, gateCode])
}

model Shift {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  shiftCode String

  name String

  startTime String

  endTime String

  mandatoryPatrol1Time String?
  mandatoryPatrol1WindowBefore Int @default(15)
  mandatoryPatrol1WindowAfter Int @default(15)

  mandatoryPatrol2Time String?
  mandatoryPatrol2WindowBefore Int @default(15)
  mandatoryPatrol2WindowAfter Int @default(15)

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  mandatoryPatrolInstances MandatoryPatrolInstance[]

  attendances Attendance[]

  @@unique([clientId, name])
  @@unique([clientId, shiftCode])
}

model GuardAssignment {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  assignmentType String @default("ROUTE")

  patrolRouteId String?
  patrolRoute   PatrolRoute? @relation(fields: [patrolRouteId], references: [id])

  assignmentGates GuardAssignmentGate[]

  patrolSessions PatrolSession[]

  mandatoryPatrolInstances MandatoryPatrolInstance[]

  attendances Attendance[]

  effectiveFrom DateTime

  effectiveTo DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([siteId])
  @@index([shiftId])
  @@index([patrolRouteId])
}

model GuardAssignmentGate {
  id String @id @default(cuid())

  assignmentId String
  assignment   GuardAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  sequence Int @default(1)

  createdAt DateTime @default(now())

  @@unique([assignmentId, gateId])
  @@index([assignmentId])
  @@index([gateId])
}

model PatrolRoute {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  routeCode String

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  assignments GuardAssignment[]

  routeGates PatrolRouteGate[]

  @@unique([siteId, name])
  @@unique([clientId, routeCode])
}

model PatrolRouteGate {
  id String @id @default(cuid())

  patrolRouteId String
  patrolRoute PatrolRoute @relation(fields: [patrolRouteId], references: [id])

  gateId String
  gate Gate @relation(fields: [gateId], references: [id])

  sequence Int

  expectedDuration Int? // minutes to next checkpoint

  createdAt DateTime @default(now())

  @@unique([patrolRouteId, gateId])
  @@unique([patrolRouteId, sequence])
}

model PatrolCheckpoint {
  id String @id @default(cuid())

  patrolSessionId String
  patrolSession   PatrolSession @relation(fields: [patrolSessionId], references: [id])

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  latitude  Float?
  longitude Float?

  remarks String?
  status  String?
  images  String[] @default([])

  subTaskResponses PatrolSubTaskResponse[]

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([patrolSessionId])
  @@index([gateId])
}

model PatrolSession {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignmentId String?
  assignment   GuardAssignment? @relation(fields: [assignmentId], references: [id])

  managerUserId String?
  managerUser   User? @relation("ManagerPatrolSessions", fields: [managerUserId], references: [id])

  checkpoints PatrolCheckpoint[]

  incidents Incident[]

  snags Snag[]

  mandatoryPatrolInstances MandatoryPatrolInstance[]

  patrolCode String

  status PatrolStatus @default(IN_PROGRESS)

  startedAt DateTime

  endedAt DateTime?

  pauseCount Int @default(0)

  totalDuration Int?

  remarks String?

  verificationStatus VerificationStatus @default(PENDING)

  verifiedById String?
  verifiedBy   User?   @relation("VerifiedPatrols", fields: [verifiedById], references: [id])

  verificationTime DateTime?

  supervisorRemarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, patrolCode])
}

model RefreshToken {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  tokenHash String

  deviceId String?

  deviceInfo String?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, deviceId])
}

model AuditLog {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  action AuditAction

  entity String

  entityId String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model Counter {
  id String @id @default(cuid())

  entity String
  
  clientId String @default("GLOBAL")

  value Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([entity, clientId])
}

model Incident {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  type           String
  severity       String
  status         String   @default("OPEN") // "OPEN" | "REVIEWED" | "RESOLVED" | "CLOSED"
  description    String
  images         String[] @default([])
  patrolSessionId String?
  patrolSession   PatrolSession? @relation(fields: [patrolSessionId], references: [id])
  gateId         String?
  gate           Gate?          @relation(fields: [gateId], references: [id])
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([employeeId])
}

model GateSubTask {
  id           String                  @id @default(cuid())
  gateId       String
  gate         Gate                    @relation(fields: [gateId], references: [id], onDelete: Cascade)
  role         UserRole                @default(SECURITY)
  taskName     String
  description  String?
  displayOrder Int                     @default(0)
  isRequired   Boolean                 @default(true)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  responses    PatrolSubTaskResponse[]

  sourceMasterItemId String?
  sourceMasterItem   SubTaskMasterItem? @relation(fields: [sourceMasterItemId], references: [id], onDelete: SetNull)

  @@unique([gateId, role, taskName])
  @@index([gateId])
  @@index([role])
  @@index([sourceMasterItemId])
}

model SubTaskMaster {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role        UserRole            @default(SECURITY)
  name        String?
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       SubTaskMasterItem[]

  @@unique([clientId, role])
  @@index([clientId])
}

model SubTaskMasterItem {
  id           String        @id @default(cuid())
  masterId     String
  master       SubTaskMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  taskName     String
  description  String?
  displayOrder Int           @default(0)
  isRequired   Boolean       @default(true)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  gateSubTasks GateSubTask[]

  @@unique([masterId, taskName])
  @@index([masterId])
}

model PatrolSubTaskResponse {
  id                  String           @id @default(cuid())
  patrolCheckpointId  String
  patrolCheckpoint    PatrolCheckpoint @relation(fields: [patrolCheckpointId], references: [id], onDelete: Cascade)
  gateSubTaskId       String?
  gateSubTask         GateSubTask?     @relation(fields: [gateSubTaskId], references: [id], onDelete: SetNull)
  taskNameSnapshot    String?
  roleSnapshot        UserRole?
  descriptionSnapshot String?
  isRequiredSnapshot  Boolean?         @default(true)
  answer              String           // "YES" | "NO"
  remarks             String?
  images              String[]         @default([])
  answeredAt          DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([patrolCheckpointId])
  @@index([gateSubTaskId])
}

model SnagCategory {
  id           String            @id @default(cuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id])
  name         String
  description  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subCategories SnagSubCategory[]
  snags        Snag[]

  @@unique([clientId, name])
  @@index([clientId])
}

model SnagSubCategory {
  id         String       @id @default(cuid())
  categoryId String
  category   SnagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  description String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  snags      Snag[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Snag {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  siteId          String
  site            Site             @relation(fields: [siteId], references: [id])
  gateId          String?
  gate            Gate?            @relation(fields: [gateId], references: [id])
  patrolSessionId String?
  patrolSession   PatrolSession?   @relation(fields: [patrolSessionId], references: [id])
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  categoryId      String?
  categoryRel     SnagCategory?    @relation(fields: [categoryId], references: [id])
  subCategoryId   String?
  subCategoryRel  SnagSubCategory? @relation(fields: [subCategoryId], references: [id])
  category        String           // Category Name text (for predefined master UI compatibility)
  subCategory     String?          // Sub-category Name text
  description     String
  priority        String           // "LOW" | "MEDIUM" | "HIGH"
  status          String           @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  images          String[]         @default([])
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  comments        SnagComment[]
  history         SnagHistory[]
  assignments     SnagAssignment[]

  @@index([clientId])
  @@index([siteId])
  @@index([employeeId])
  @@index([patrolSessionId])
}

model SnagComment {
  id        String   @id @default(cuid())
  snagId    String
  snag      Snag     @relation(fields: [snagId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  comment   String
  createdAt DateTime @default(now())

  @@index([snagId])
  @@index([userId])
}

model SnagHistory {
  id            String   @id @default(cuid())
  snagId        String
  snag          Snag     @relation(fields: [snagId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  previousState String?
  newState      String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([snagId])
  @@index([userId])
}

model SnagAssignment {
  id           String    @id @default(cuid())
  snagId       String
  snag         Snag      @relation(fields: [snagId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User      @relation("SnagAssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User      @relation("SnagAssignedBy", fields: [assignedById], references: [id])
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@index([snagId])
  @@index([assignedToId])
  @@index([assignedById])
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model ClientNotificationSettings {
  id                          String                  @id @default(cuid())
  clientId                    String                  @unique
  client                      Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patrolCompletedEmailEnabled Boolean                 @default(true)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  recipients                  NotificationRecipient[]

  @@index([clientId])
}

model NotificationRecipient {
  id         String                     @id @default(cuid())
  settingsId String
  settings   ClientNotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  email      String
  role       String                     @default("GLOBAL")
  isActive   Boolean                    @default(true)
  createdAt  DateTime                   @default(now())

  @@unique([settingsId, email, role])
  @@index([settingsId])
}

model NotificationDelivery {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  patrolSessionId   String
  type              String             @default("PATROL_COMPLETED")
  recipient         String
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  @@unique([type, patrolSessionId, recipient])
  @@index([clientId])
  @@index([patrolSessionId])
}

model ManagerClientMembership {
  id            String   @id @default(cuid())
  managerUserId String
  managerUser   User     @relation("UserManagerMemberships", fields: [managerUserId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation("ClientManagerMemberships", fields: [clientId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([managerUserId, clientId])
  @@index([managerUserId])
  @@index([clientId])
}

model FaceEnrollment {
  id String @id @default(cuid())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  status FaceEnrollmentStatus @default(REGISTERED)

  encryptedTemplate String

  modelName          String @default("MobileFaceNet")
  modelVersion       String @default("v1")
  embeddingDimension Int    @default(512)

  registeredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revokedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([employeeId])
}

model MandatoryPatrolInstance {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignmentId    String
  assignment      GuardAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftDate       DateTime        @db.Date
  sequence        Int             // 1 or 2
  scheduledAt     DateTime
  windowStart     DateTime
  windowEnd       DateTime
  status          String          @default("UPCOMING") // "UPCOMING" | "DUE" | "COMPLETED" | "MISSED"
  completedAt     DateTime?
  patrolSessionId String?
  patrolSession   PatrolSession?  @relation(fields: [patrolSessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([assignmentId, shiftDate, sequence])
  @@index([clientId, status])
  @@index([employeeId, shiftDate])
  @@index([windowStart, windowEnd])
}

model Notification {
  id             String                      @id @default(cuid())
  clientId       String
  client         Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String                      // e.g. "MANDATORY_PATROL_DUE", "MANDATORY_PATROL_COMPLETED", "MANDATORY_PATROL_MISSED"
  title          String
  message        String
  entityType     String?                     // e.g. "MandatoryPatrolInstance"
  entityId       String?
  metadata       Json?
  idempotencyKey String?                     @unique
  createdAt      DateTime                    @default(now())
  recipients     NotificationUserRecipient[]

  @@index([clientId])
}

model NotificationUserRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, isRead])
}

model Attendance {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  assignmentId String?
  assignment   GuardAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  attendanceDate DateTime @db.Date // Business Date
  
  checkInAt DateTime
  checkOutAt DateTime?

  status String @default("PRESENT") // "PRESENT" | "LATE" | "COMPLETED" | "OFF"
  isLate Boolean @default(false)

  verificationMethod String @default("FACE_VERIFICATION")
  verificationStatus String @default("VERIFIED") // "VERIFIED" | "PENDING"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, attendanceDate])
  @@index([clientId, attendanceDate])
  @@index([employeeId, attendanceDate])
  @@index([siteId])
  @@index([shiftId])
}


