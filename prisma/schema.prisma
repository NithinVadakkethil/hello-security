generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  MANAGER
  SUPERVISOR
  SECURITY
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum IdentificationMethod {
  QR
  RFID
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  DOWNLOAD
}

enum PatrolStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

model Client {
  id String @id @default(cuid())

  clientCode String @unique

  companyName String

  email String @unique

  phone String?

  address String?

  subscriptionStatus SubscriptionStatus @default(TRIAL)

  identificationMethod IdentificationMethod @default(QR)

  maxEmployees Int @default(50)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  employees Employee[]

  assignments GuardAssignment[]

  patrolSessions PatrolSession[]

  sites Site[]

  shifts Shift[]

  patrolRoutes PatrolRoute[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  incidents Incident[]
}

model User {
  id String @id @default(cuid())

  clientId String?

  employeeId String? @unique

  client   Client?   @relation(fields: [clientId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  email    String   @unique
  password String
  role     UserRole

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model Employee {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  employeeNumber String

  firstName String

  lastName String

  email String?

  phone String?

  photo String?

  designation String?

  joiningDate DateTime?

  identificationMethod IdentificationMethod @default(QR)

  qrCode String?

  rfidTag String?

  status EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User?

  incidents Incident[]

  @@unique([clientId, employeeNumber])
}

model Site {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  siteCode String @unique

  name String

  gates Gate[]

  patrolRoutes PatrolRoute[]

  assignments GuardAssignment[]

  address String?

  latitude Float?

  longitude Float?

  radius Int @default(100)

  contactPerson String?

  contactPhone String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
}

model Gate {
  id String @id @default(cuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  patrolCheckpoints PatrolCheckpoint[]

  routeGates PatrolRouteGate[]

  gateCode String @unique

  name String

  description String?

  latitude Float?

  longitude Float?

  sequence Int

  qrCode String?

  nfcTag String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
}

model Shift {
  id String @id @default(cuid())

  clientId String

  client Client @relation(fields: [clientId], references: [id])

  assignments GuardAssignment[]

  shiftCode String @unique

  name String

  startTime String

  endTime String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
}

model GuardAssignment {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  patrolRouteId String
  patrolRoute   PatrolRoute @relation(fields: [patrolRouteId], references: [id])

  patrolSessions PatrolSession[]

  effectiveFrom DateTime

  effectiveTo DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([siteId])
  @@index([shiftId])
  @@index([patrolRouteId])
}

model PatrolRoute {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  routeCode String @unique

  name String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  assignments GuardAssignment[]

  routeGates PatrolRouteGate[]

  @@unique([siteId, name])
}

model PatrolRouteGate {
  id String @id @default(cuid())

  patrolRouteId String
  patrolRoute PatrolRoute @relation(fields: [patrolRouteId], references: [id])

  gateId String
  gate Gate @relation(fields: [gateId], references: [id])

  sequence Int

  expectedDuration Int? // minutes to next checkpoint

  createdAt DateTime @default(now())

  @@unique([patrolRouteId, gateId])
  @@unique([patrolRouteId, sequence])
}

model PatrolCheckpoint {
  id String @id @default(cuid())

  patrolSessionId String
  patrolSession   PatrolSession @relation(fields: [patrolSessionId], references: [id])

  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  latitude  Float?
  longitude Float?

  remarks String?

  scannedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([patrolSessionId])
  @@index([gateId])
}

model PatrolSession {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignmentId String
  assignment   GuardAssignment @relation(fields: [assignmentId], references: [id])

  checkpoints PatrolCheckpoint[]

  patrolCode String

  status PatrolStatus @default(IN_PROGRESS)

  startedAt DateTime

  endedAt DateTime?

  pauseCount Int @default(0)

  totalDuration Int?

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([clientId, patrolCode])
}

model RefreshToken {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  tokenHash String

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())

  clientId String?

  userId String

  client Client? @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  action AuditAction

  entity String

  entityId String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model Counter {
  id String @id @default(cuid())

  entity String @unique

  value Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Incident {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  type           String
  severity       String
  description    String
  images         String[] @default([])
  patrolSessionId String?
  gateId         String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([employeeId])
}
